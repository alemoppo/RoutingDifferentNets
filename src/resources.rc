/*
 * resources.rc - risorse del programma.
 * Il manifest applicativo richiede privilegi amministrativi (UAC) e
 * imposta il supporto DPI.
 */
#include <windows.h>

#define ID_MANIFEST 24
#define ID_VERSION  1

/* `1 24` lega il manifest al modulo eseguibile (RT_MANIFEST). */
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Network Route Manager"
            VALUE "FileDescription",  "Gestione route IP -> interfaccia di rete (Windows)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "route_manager"
            VALUE "OriginalFilename", "route_manager.exe"
            VALUE "ProductName",      "Network Route Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END